**/*.map

# Dados temporários / dev
valeria_leads/
/tmp/

# Documentação interna
**/*.md
PROMPT_MASTER.md

# Git e editor
.git/
.gitignore
.vscode/
.editorconfig

# Dependências
**/node_modules/**
package.json
package-lock.json
