# Configs e infraestrutura
firebase.json
firebase-valeria.json
firestore.rules
firestore.indexes.json
.firebaseignore

# Scripts de CI/CD — não devem ser públicos
*.bat
*.js
*.sh

# Código-fonte — nunca expor no Hosting
