{
  "hosting": {
    "predeploy": ["node scripts/guard_deploy_branch.js"],
    "public": ".",
    "ignore": [
      "firebase.json",
      "firebase-valeria.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "functions-valeria/**",
      "firestore.rules",
      "firestore.indexes.json",
      "**/*.ts",
      "**/*.md",
      "**/*.bat",
      "git_push_valeria.js",
      "git_commit_push.js",
      "valeria_leads",
      "marketing-integracoes.html",
      "**/*.log",
      "**/*.pdf",
      "**/*.txt",
      "Id visual - VR e Vitre/**",
      "scripts/**",
      "index [0-9]*.html",
      "*.gcloudignore*",
      "functions_ponte_homolog/**"
    ],
    "rewrites": [
      { "source": "**", "destination": "/index.html" }
    ]
  },
  "firestore": {
    "predeploy": ["node scripts/guard_deploy_branch.js"],
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "predeploy": ["npm --prefix functions run build", "node scripts/guard_deploy_branch.js"],
      "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log", "*.local"]
    },
    {
      "source": "functions_ponte_homolog",
      "codebase": "pontehomolog",
      "predeploy": [
        "node scripts/guard_deploy_branch.js",
        "node scripts/guard_ponte_homolog_only_deploy.js",
        "node scripts/prepare_ponte_homolog_deploy_package.js",
        "npm --prefix functions_ponte_homolog install",
        "npm --prefix functions_ponte_homolog run build"
      ],
      "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log", "*.local"]
    }
  ],
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "functions": { "port": 5001 },
    "hosting": { "port": 5050 },
    "ui": { "enabled": true, "port": 4000 },
    "singleProjectMode": true
  }
}
