{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firebase-valeria.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "functions-valeria/**",
      "firestore.rules",
      "firestore.indexes.json",
      "**/*.ts",
      "**/*.md",
      "**/*.bat",
      "**/*.js",
      "valeria_leads",
      "marketing-integracoes.html"
    ],
    "rewrites": [
      { "source": "**", "destination": "/index.html" }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log", "*.local"]
    }
  ],
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "hosting": { "port": 5050 },
    "ui": { "enabled": true, "port": 4000 },
    "singleProjectMode": true
  }
}
