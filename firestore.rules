rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Funções auxiliares ──────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function userRole() {
      return request.auth.token.role;
    }

    function isCompany(companyId) {
      return isAuthenticated() && request.auth.token.companyId == companyId;
    }

    // master: acesso total, inclui gerenciamento de usuários e config
    function isMaster() {
      return isAuthenticated() && userRole() == 'master';
    }

    // master: gerencia o ERP (config, financeiro, permissões, usuários)
    // NOTA: 'admin' mantido temporariamente para tokens legados enquanto a migração
    // (scripts/migrate_admin_to_master.js --apply) não for executada e verificada.
    // Remover 'admin' destas regras somente após confirmar zero registros remanescentes.
    function isAdmin() {
      return isAuthenticated() && (
        userRole() == 'master' || userRole() == 'admin'
      );
    }

    // comercial: pode ler/escrever orçamentos, CRM, clientes — não toca em config
    function isComercial() {
      return isAuthenticated() && (
        userRole() == 'comercial' || userRole() == 'master' || userRole() == 'admin'
      );
    }

    // produção: acesso operacional (Kanban/OS, estoque)
    function isProducao() {
      return isAuthenticated() && (
        userRole() == 'producao' || userRole() == 'master' || userRole() == 'admin'
      );
    }

    // financeiro: módulos financeiros/fiscais + leitura de orçamentos p/ conciliação
    // (achado real da homologação anterior: esta função não existia — o perfil
    // financeiro, apesar de válido em toda a Cloud Function e no client-side,
    // não conseguia nem logar contra as Rules antigas)
    function isFinanceiro() {
      return isAuthenticated() && (
        userRole() == 'financeiro' || userRole() == 'master' || userRole() == 'admin'
      );
    }

    // qualquer perfil autorizado (inclui financeiro agora)
    function isAnyStaff() {
      return isAuthenticated() && userRole() in ['master', 'admin', 'comercial', 'producao', 'financeiro'];
    }

    // ── marketing_connections ───────────────────────────────────────────────
    match /marketing_connections/{docId} {
      allow read:  if isAuthenticated() && isCompany(resource.data.companyId);
      allow write: if false; // somente backend
    }

    // ── marketing_daily_metrics ─────────────────────────────────────────────
    match /marketing_daily_metrics/{docId} {
      allow read:  if isAuthenticated() && isCompany(resource.data.companyId);
      allow write: if false;
    }

    // ── marketing_sync_logs ─────────────────────────────────────────────────
    match /marketing_sync_logs/{docId} {
      allow read:  if isMaster();
      allow write: if false;
    }

    // ── erp_vr: coleção principal do ERP ───────────────────────────────────
    // Modelo de dados: cada "tabela" lógica é UM ÚNICO documento contendo um
    // array inteiro serializado em JSON (campo "data", string). Isso significa
    // que Rules por documento conseguem controlar QUEM mexe em cada tabela,
    // mas NÃO conseguem diferenciar operações dentro do mesmo documento (ex.:
    // "criar uma solicitação de compra" vs. "aprovar/precificar uma compra
    // existente" são ambas, do ponto de vista do Firestore, a mesma operação
    // — sobrescrever o campo "data" inteiro de erp_vr/compras). Onde isso
    // importa (perfil Produção não pode aprovar/precificar/pagar a própria
    // solicitação de compra), a separação real está registrada como
    // bloqueador arquitetural no relatório de homologação, não fingida aqui.
    match /erp_vr/{docId} {

      // Array legado de usuários — NÃO é mais a fonte do login (o frontend
      // atual lê exclusivamente erp_vr_usuarios/{uid}). Leitura restrita a
      // Master, só para auditoria/histórico do período de transição; nunca
      // mais uma dependência de acesso para Comercial/Produção/Financeiro.
      allow read: if isMaster() && docId == 'erp_usuarios';
      allow write: if isMaster() && docId == 'erp_usuarios';

      // Segredos administrativos — só Master pode ler E escrever.
      allow read, write: if isMaster() && docId in [
        'erp_master_pwd', 'erp_bank_config',
        'erp_mach_presets', 'erp_inact_mins', 'erp_mat_prices',
        'valeria_authorized_agents'
      ];

      // erp_permissoes: matriz de visibilidade de página por perfil
      // (booleanos, sem segredo nenhum) — consumida no cliente por
      // usrLoadPerms()/secApplyPerms() para decidir o que cada perfil vê na
      // sidebar. Achado real desta rodada: estava só-Master (mesmo grupo
      // acima), o que tornava a personalização de permissões (tela
      // Config>Usuários) 100% inerte para qualquer perfil não-master — o
      // cliente nunca conseguia LER o próprio documento de permissões
      // customizadas, então usrLoadPerms() sempre caía no PERM_DEFAULT
      // hardcoded (que nem inclui 'compras'/'fornecedores' para produção),
      // escondendo a página de Compras da sidebar de Produção mesmo com a
      // Cloud Function comprasCriarSolicitacao exigindo exatamente esse
      // perfil. Escrita continua exclusiva de Master — não eleva privilégio.
      allow read: if isAnyStaff() && docId == 'erp_permissoes';
      allow write: if isMaster() && docId == 'erp_permissoes';

      // erp_config: todo o staff precisa LER (cálculo de preço no orçamento,
      // taxa de imposto no DRE), mas só Master decide os percentuais.
      allow read: if isAnyStaff() && docId == 'erp_config';
      allow write: if isMaster() && docId == 'erp_config';

      // Auditoria: qualquer perfil grava (append de ações auditadas por
      // secAuditLog em todas as telas); só Master lê o log completo.
      allow write: if isAnyStaff() && docId == 'erp_audit_log';
      allow read: if isMaster() && docId == 'erp_audit_log';

      // Estado de UI (sidebar aberta/fechada) — sem dado sensível.
      allow read, write: if isAnyStaff() && docId == 'erp_sb_state';

      // Financeiro: Contas a Pagar/Receber e transações de caixa — é aqui
      // (não em "compras") que aprovação de preço/pagamento/quitação
      // realmente acontece, então a restrição de perfil aqui É efetiva.
      // 'fin_cr' também aceita isComercial() (achado 2026-08-07): gerar OS
      // a partir de um orçamento aprovado (orcEnvGerarOS()) grava a
      // entrada/saldo em fin_cr na MESMA transação que atualiza o próprio
      // orçamento — sem isso, a transação inteira falhava com permissão
      // negada para qualquer conta que não fosse master/admin, quebrando
      // por completo o botão "Gerar OS" para o perfil Comercial (o único
      // que legitimamente aciona essa ação). Alargamento aditivo — não
      // remove nada do que Financeiro já podia fazer.
      allow read, write: if (isFinanceiro() || (isComercial() && docId=='fin_cr')) && docId in ['fin_tx', 'fin_cp', 'fin_cr', 'erp_caixa_ant'];

      // Orçamentos: Comercial cria/edita; Financeiro só lê (conciliação de
      // receita no DRE, contas a receber geradas a partir de orçamento
      // aprovado). Nenhum campo de custo/markup interno é gravado no
      // orçamento (corrigido nesta rodada — ver cfgHashNaoReversivel).
      allow read: if (isComercial() || isFinanceiro()) && docId == 'orcamentos';
      allow write: if isComercial() && docId == 'orcamentos';

      // CRM, clientes e operação comercial
      allow read, write: if isComercial() && (
        docId in ['crm_leads', 'crm_prospects', 'crm_reativacao', 'crm_site_leads',
                  'crm_base_idx_meta', 'clientes', 'clientes_lixeira',
                  'erp_client_history', 'erp_vendedores', 'erp_metas_vendedor',
                  'erp_posvendas', 'erp_orc_produtos', 'chatvolt_agent_id',
                  'chatvolt_fase', 'chatvolt_marca', 'shopify_cfg']
        || docId.matches('crm_base_idx_[0-9]+')
      );

      // Produção: OS, estoque, planificação. Compras: Produção cria/recebe;
      // Comercial só lê (visibilidade de status para o cliente). Ver nota
      // acima sobre o limite de Rules para "criar vs. aprovar" dentro do
      // mesmo documento — aprovar/precificar fica de fato bloqueado só
      // porque a etapa de pagamento (fin_cp) exige Financeiro.
      allow read, write: if isProducao() && (
        docId in ['kb_os', 'erp_os_counter', 'compras',
                  'erp_compras_counter', 'erp_fornecedores']
        || docId.matches('erp_plan_.*')
      );
      // 'kb_os'/'erp_os_counter' também aceitam isComercial() (achado
      // 2026-08-07, mesma causa do alargamento de fin_cr acima):
      // orcEnvGerarOS() grava a nova OS + incrementa o contador dentro da
      // mesma transação atômica que aprova o orçamento — sem isto, a
      // transação inteira falhava com permissão negada para o perfil
      // Comercial (o único que legitimamente gera OS a partir de um
      // orçamento aprovado). Alargamento aditivo — Produção mantém acesso
      // total e continua sendo o único a mexer nas demais chaves deste
      // bloco (compras/erp_plan_*).
      allow read, write: if isComercial() && docId in ['kb_os', 'erp_os_counter'];

      // Rodada 2 (2026-08-07), item P0.6 — privacidade financeira real da
      // Produção. Achado: 'kb_os' guardava valor/totalGeral/parcelas/
      // formaPgto/pagtoTipo/valorEntrada/restante (e itens[].unit/total)
      // DENTRO do mesmo documento que a Produção precisa ler/escrever para
      // trabalhar no Kanban — Rules só decidem por documento inteiro,
      // nunca por campo, então qualquer papel com leitura em 'kb_os'
      // sempre recebia os valores financeiros de TODAS as OS, mesmo que a
      // interface só os escondesse via CSS/JS. Campos financeiros agora
      // vivem num documento SEPARADO ('kb_os_fin', gravado pelo cliente
      // dentro da MESMA transação que grava 'kb_os' — nunca fica um sem o
      // outro). Deliberadamente SEM isProducao() aqui — é a única forma
      // real (não apenas visual) de impedir esse papel de ler dado
      // financeiro de uma OS.
      allow read, write: if (isMaster() || isFinanceiro() || isComercial()) && docId == 'kb_os_fin';

      // ── RULES CANDIDATAS (preparadas, NÃO publicadas — auditoria Fase F,
      // FASE 2-8, 2026-08-05) ──────────────────────────────────────────────
      // Achado: 'stock'/'erp_stock_log'/'retalhos' são documentos agregados
      // (blob JSON em `data`) — Rules não conseguem validar campo a campo
      // (não dá para permitir escrever `qty` mas negar zerar o documento
      // inteiro). A única forma de fechar o bypass de verdade é mover TODA
      // escrita para Cloud Functions (feito nesta rodada — ver
      // functions/src/estoque.ts e producao.ts, todas usando Admin SDK, que
      // sempre ignora Rules) e negar escrita client-side aqui.
      //
      // ⚠️ BLOQUEADOR DE DEPLOY CONHECIDO, documentado e não escondido: o
      // fluxo LEGADO de recebimento de Compras v1 (comprasReceberModal(),
      // ramo `else` — ativo quando _HOMOLOG_MODE é false, ou seja, é o que
      // roda em PRODUÇÃO hoje, já que _HOMOLOG_MODE só liga com
      // localhost+?emulator=1) ainda escreve 'stock' diretamente do cliente
      // ao registrar recebimento (index.html, dentro de comprasReceberModal,
      // incremento de STOCK[item.material].qty). Publicar este `allow
      // write: if false` em produção QUEBRARIA esse fluxo legado ainda
      // ativo. Isso não foi migrado nesta rodada porque pertence à migração
      // maior, já rastreada separadamente, de Compras v1 → v2 (documento-
      // por-registro) — mesma arquitetura do bloco erp_vr_compras* abaixo.
      // Publicar esta Rule específica requer primeiro migrar ou aposentar
      // esse ramo legado. Ver relatório final desta rodada, item de
      // pendências.
      // Escrita client-side ausente de propósito para estes 5 docIds — nenhum
      // 'allow write' os cobre mais, então o deny-by-default do Firestore se
      // aplica (mesma convenção do restante deste arquivo — ver nota no fim
      // do bloco: "Nega tudo o mais por padrão"). Só Admin SDK (Cloud
      // Functions) escreve, via estoque.ts/producao.ts.
      allow read: if isProducao() && docId in
        ['stock', 'stock_deleted', 'erp_stock_log', 'retalhos', 'retalhos_seq'];
      allow read: if isComercial() && docId in ['compras', 'erp_fornecedores', 'erp_plan_produtos'];

      // Planejamento de produtos/planificação (catálogo usado tanto no
      // orçamento quanto na produção) — leitura para qualquer staff,
      // escrita para quem planeja produto (Produção) ou Master.
      allow read: if isAnyStaff() && docId == 'erp_plan_produtos';
      allow write: if isProducao() && docId == 'erp_plan_produtos';

      // Rodada 3 (2026-08-08) — camada histórica financeira (2018-2026),
      // importada de PDFs de fechamento antigos via
      // scripts/import_historico_financeiro.js. Mesmo grupo de acesso que
      // fin_cr/fin_cp/fin_tx (Master+Financeiro) — é dado financeiro
      // gerencial (vendas/entradas/despesas/lucro por competência), nunca
      // exposto à Produção. Comercial não recebe por padrão nesta rodada
      // (decisão a rever se um relatório comercial histórico for pedido
      // depois — não presumido aqui). Nenhuma escrita client-side direta:
      // todo o hist_* é gravado só pelo importador (Admin SDK) ou por
      // Master/Financeiro corrigindo staging manualmente.
      allow read, write: if (isMaster() || isFinanceiro()) && docId in
        ['hist_mensal', 'hist_nf', 'hist_caixa_diario', 'hist_movimentacoes',
         'hist_despesas', 'hist_import_runs'];

      // Nega tudo o mais por padrão — nenhum catch-all amplo.
    }

    // ── erp_vr/erp_orc_counter: contador atômico do número oficial de
    // orçamento (Rodada E.2) — caminho exato, FORA do match genérico
    // erp_vr/{docId} acima, para que nenhuma regra ampla de outro documento
    // (ex.: o precedente já existente 'allow read, write: if isProducao()'
    // usado por erp_compras_counter) se aplique aqui por acidente. Ao
    // contrário desse precedente — que autoriza escrita irrestrita de
    // qualquer forma no documento —, este bloco valida o CONTEÚDO da
    // escrita, não só o papel de quem escreve:
    //  - create: só aceita o valor inicial canônico (n=1), só o campo 'n';
    //  - update: só aceita incremento atômico de exatamente +1 sobre o
    //    valor já gravado (resource.data.n, lido pela própria regra — não
    //    pelo cliente), nunca reduz/reseta/pula, nunca outro campo;
    //  - delete: sempre negado (excluir e recriar seria um reset disfarçado).
    // A atomicidade entre reservas concorrentes continua garantida pela
    // transação do Firestore (mesma técnica já usada e testada em
    // comprasProximoNumeroAtomico) — esta regra só impede que uma escrita
    // (transacional ou não) grave um valor fora do incremento válido.
    match /erp_vr/erp_orc_counter {
      allow read: if isComercial();

      allow create: if isComercial()
        && request.resource.data.keys().hasOnly(['n'])
        && request.resource.data.n == 1;

      allow update: if isComercial()
        && resource != null
        && request.resource.data.keys().hasOnly(['n'])
        && request.resource.data.n is int
        && request.resource.data.n == resource.data.n + 1;

      allow delete: if false;
    }

    // ── erp_vr_usuarios: documento por UID (normalizado, substitui o array
    // erp_vr/erp_usuarios para fins de login/identificação de perfil) ───────
    // Cada usuário lê SÓ o próprio documento; só Master lista todos. Nenhum
    // perfil escreve aqui — toda alteração passa por adminCreateUser/
    // adminUpdateUserRole/adminToggleStatus (Cloud Functions, Admin SDK),
    // que verificam master no servidor antes de gravar. Isso, sozinho, já
    // impede autoelevação: nenhum client-side write é aceito.
    match /erp_vr_usuarios/{uid} {
      allow read:  if isAuthenticated() && (request.auth.uid == uid || isMaster());
      allow write: if false;
    }

    // ── erp_vr_rascunho_orc: rascunho do Novo Orçamento em andamento (Fase F,
    // Seção 5) — sobrevive ao bloqueio automático + refresh da página
    // bloqueada, mas só é legível/gravável pelo PRÓPRIO uid que o criou.
    // Nunca contém senha/token/sessão — só os campos comerciais do wizard
    // (nome/doc/email/tel/cidade/vendedor/itens/marca) que já trafegam em
    // claro no client de qualquer forma. Isolamento total: nem Master lê o
    // rascunho de outra conta (diferente de erp_vr_usuarios acima) — é um
    // rascunho pessoal em edição, não um registro administrativo.
    match /erp_vr_rascunho_orc/{uid} {
      allow read, write: if isAuthenticated() && request.auth.uid == uid;
    }

    // ── Compras — documento-por-registro. Toda escrita passa por Cloud
    // Function (comprasCriarSolicitacao/Aprovar/RegistrarRecebimento/
    // AdicionarDocumento/RegistrarPagamento/Cancelar em functions/src/
    // compras.ts), que verifica o perfil do chamador no servidor, valida a
    // transição de status e é transacional/idempotente. O client NUNCA
    // escreve direto nessas coleções — só lê. Isso resolve o achado da
    // rodada anterior: Rules por documento não conseguem diferenciar
    // "Produção cria uma solicitação" de "Produção aprova uma compra
    // existente" quando ambas seriam a mesma operação (sobrescrever o
    // documento); aqui não existe operação de escrita direta alguma —
    // só a Cloud Function certa para cada transição.
    match /erp_vr_compras/{compraId} {
      allow read:  if isAnyStaff();
      allow write: if false;
    }
    match /erp_vr_compras_counter/{docId} {
      allow read:  if isAnyStaff();
      allow write: if false; // incrementado só dentro da transação da Cloud Function
    }
    match /erp_vr_compras_recebimentos/{recId} {
      allow read:  if isAnyStaff();
      allow write: if false;
    }
    match /erp_vr_compras_documentos/{docId} {
      allow read:  if isFinanceiro() || isProducao(); // produção vê que o documento chegou; valores ficam em fin_cp
      allow write: if false;
    }
    match /erp_vr_compras_parcelas/{parcelaId} {
      allow read:  if isFinanceiro();
      allow write: if false;
    }
    match /erp_vr_fin_cp/{cpId} {
      allow read:  if isFinanceiro();
      allow write: if false;
    }
    match /erp_vr_fin_pagamentos/{pagId} {
      allow read:  if isFinanceiro();
      allow write: if false;
    }
    match /erp_vr_stock_movimentos/{movId} {
      allow read:  if isProducao();
      allow write: if false;
    }
    match /compras_idem_keys/{key} {
      allow read, write: if false; // uso interno exclusivo das Cloud Functions
    }
    match /compras_audit_log/{entryId} {
      allow read:  if isMaster();
      allow write: if false;
    }

    // ── Catálogo Vitre + Orçamento de Catálogo (Fase G, 2026-08-06) ─────────
    // Mesma arquitetura documento-por-registro + Cloud Function do bloco
    // Compras acima — nenhuma escrita client-side em nenhuma destas
    // coleções (vitreImportarProdutos/CriarOuEditarProduto/
    // AtivarDesativarProduto/DuplicarProduto/CriarOrcamento/
    // AtualizarOrcamento em functions/src/vitre.ts fazem toda a validação
    // de perfil/campo comercial/nível mínimo no servidor).
    match /vitre_produtos/{sku} {
      allow read:  if isAnyStaff(); // Comercial consulta p/ orçamento; Produção consulta ficha técnica
      allow write: if false;
    }
    match /vitre_produto_historico/{id} {
      allow read:  if isAnyStaff();
      allow write: if false;
    }
    match /vitre_importacoes/{id} {
      allow read:  if isMaster(); // só quem importa (master-only) vê o histórico de importação
      allow write: if false;
    }
    match /vitre_orcamentos/{orcId} {
      allow read:  if isComercial() || isFinanceiro();
      allow write: if false;
    }
    // vitre_os (Parte 9 da homologação, 2026-08-06) — resultado da
    // conversão de orçamento em Ordem de Serviço. Produção só vê ISTO,
    // nunca o orçamento comercial de origem (vitre_orcamentos acima
    // continua Produção-negado, decisão já testada/homologada).
    match /vitre_os/{osId} {
      allow read:  if isComercial() || isProducao() || isFinanceiro();
      allow write: if false; // só vitreConverterOrcamentoParaOS grava
    }
    match /vitre_idem_keys/{key} {
      allow read, write: if false; // uso interno exclusivo das Cloud Functions
    }
    match /vitre_audit_log/{entryId} {
      allow read:  if isMaster();
      allow write: if false;
    }

    // ── Valéria × Catálogo Vitre (Fase G, Parte C, 2026-08-06) — PREPARAÇÃO.
    // Estas Functions são onRequest (Bearer token da Valéria, não Firebase
    // Auth de staff) — o cliente do ERP nunca chama nem lê estas coleções
    // diretamente; só o Admin SDK (que ignora Rules) escreve. Master pode
    // ler para auditoria/depuração do que a Valéria fez.
    match /valeria_vitre_idem_keys/{key} {
      allow read, write: if false; // uso interno exclusivo das Functions
    }
    match /valeria_vitre_audit_log/{entryId} {
      allow read:  if isMaster();
      allow write: if false;
    }
    match /valeria_handoffs/{id} {
      allow read:  if isComercial() || isMaster(); // Comercial precisa ver o que a Valéria encaminhou
      allow write: if false;
    }

    // ── erp_vr_orcamentos: núcleo comercial do orçamento (sem custo/markup) ──
    // Ver subcoleção /interno abaixo para os dados sensíveis.
    match /erp_vr_orcamentos/{orcId} {
      allow read:  if isComercial() || isFinanceiro();
      allow write: if isComercial();

      // Dados internos (custo, margem, markup, overhead, imposto) — nunca
      // lidos pelo Comercial. Só Master/Financeiro (conciliação de DRE).
      match /interno/{doc} {
        allow read:  if isFinanceiro();
        allow write: if isMaster();
      }
    }

    // ── valeria_simulations: somente Cloud Functions (service account) ──────
    match /valeria_simulations/{docId} {
      allow read:  if isAdmin(); // admin pode auditar
      allow write: if false;     // somente Cloud Functions
    }

    // ── valeria_idem_keys: idempotência — somente Cloud Functions ────────────
    match /valeria_idem_keys/{docId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // ── valeria_rate_limits: rate limiting — somente Cloud Functions ─────────
    match /valeria_rate_limits/{docId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // ── valeria_conversations: histórico de conversas ────────────────────────
    match /valeria_conversations/{docId} {
      allow read:  if isComercial();
      allow write: if false; // somente Cloud Functions
    }

    // ── valeria_msgs: mensagens individuais ──────────────────────────────────
    match /valeria_msgs/{docId} {
      allow read:  if isComercial();
      allow write: if false; // somente Cloud Functions
    }

    // ── valeria_alertas: leitura admin/master ────────────────────────────────
    match /valeria_alertas/{docId} {
      allow read:  if isAdmin();
      allow write: if false; // somente Cloud Functions
    }

    // ── interacoes_valeria: histórico de mensagens ───────────────────────────
    match /interacoes_valeria/{docId} {
      allow read:  if isComercial();
      allow write: if false; // somente Cloud Functions
    }

    // ── Nega por padrão qualquer coleção não listada explicitamente acima ────
    // ACHADO CRÍTICO desta rodada (autodescoberto e autocorrigido): a versão
    // anterior deste catch-all fazia `allow read,write: if isAuthenticated()
    // && !(col in [lista fixa])` — como a lista fixa nunca foi atualizada ao
    // criar as novas coleções (erp_vr_compras, erp_vr_fin_cp, erp_vr_usuarios
    // etc.), QUALQUER usuário autenticado conseguia ler/escrever direto
    // nelas, ignorando por completo as regras específicas escritas acima e
    // as Cloud Functions que deveriam ser o único caminho de escrita. Prova
    // real: PATCH direto em erp_vr_compras (que tem `allow write: if false`
    // no match block específico) retornava HTTP 200 antes desta correção —
    // porque o catch-all, avaliado em paralelo, também "match"ava o mesmo
    // caminho e concedia com uma condição mais permissiva (Firestore Rules
    // combina múltiplos match blocks que casam o mesmo caminho com OR: se
    // QUALQUER um permite, a operação é permitida). Corrigido trocando a
    // lista de exclusão por negação total — nenhuma coleção legítima do
    // app depende deste catch-all (todo acesso do cliente já passa pelos
    // match blocks explícitos acima); um catch-all "permissivo com lista de
    // exclusão" é exatamente o anti-padrão que a homologação pediu para
    // evitar, e a lista de exclusão comprovadamente fica desatualizada.
    match /{col}/{docId=**} {
      allow read, write: if false;
    }

  }
}
