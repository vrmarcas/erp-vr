# =============================================================================
# .gitignore — ERP VR Marcas
# Criado em: 2026-07-31
# =============================================================================

# ── Dependências ──────────────────────────────────────────────────────────────
# Reproduzíveis via: npm install (raiz, functions/, functions-valeria/)
node_modules/

# ── Build TypeScript ──────────────────────────────────────────────────────────
# Reproduzíveis via: npm run build (tsc) em cada codebase
# functions/lib/     → cd functions && npm run build
# functions-valeria/ → cd functions-valeria && npm run build
functions/lib/
functions-valeria/lib/

# ── Cache do Firebase CLI ─────────────────────────────────────────────────────
# Gerado automaticamente pelo firebase CLI (não precisa versionar)
.firebase/

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
firebase-debug.log*
ui-debug.log*

# ── Secrets / variáveis de ambiente ──────────────────────────────────────────
# ATENÇÃO: nunca commitar credenciais, tokens ou chaves privadas
.env
.env.*
.runtimeconfig.json
serviceAccountKey*.json
*-service-account*.json
*-credentials*.json

# ── Sistema Operacional ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── IDEs e editores ───────────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.suo
*.user
*.swp
*~

# ── Arquivos temporários ──────────────────────────────────────────────────────
*.tmp
*.temp

# ── Artefatos de extração dos testes (scripts/test_*.js) ─────────────────────
# Cada scripts/test_*.js extrai as funções reais de index.html (por contagem de
# chaves) para um módulo temporário só para o require() do teste — 100%
# reproduzível a cada execução, nunca deve ser commitado. Padrão específico
# (não um *.js genérico) para não esconder arquivos reais de scripts/.
scripts/_*_extracted.tmp.js
